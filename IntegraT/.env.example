# IntegraT — variables de entorno (PLANTILLA, sin valores reales)
# Copia este archivo como .env y completa los valores. .env NUNCA se sube a Git.
# Descripción de cada variable: docs/CONFIGURACION_SERVIDOR.md §2

APP_ENV=

# --- Base de datos: PostgreSQL, base NUEVA "integrat" (nunca la de la v1) ---
DB_HOST=
DB_PORT=
DB_NAME=integrat
DB_USER=
DB_PASSWORD=
# disabled | preferred | required | verify_identity (este último exige DB_SSL_CA)
DB_SSLMODE=
DB_SSL_CA=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=15

# --- MySQL LOCAL para pruebas automáticas (Docker). Nunca apuntar a la base real. ---
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_NAME=integrat_test
TEST_DB_USER=integrat_test
TEST_DB_PASSWORD=
TEST_DB_ROOT_PASSWORD=

# Solo para ejecutar migraciones (rol dueño del esquema)
DB_MIGRATIONS_USER=
DB_MIGRATIONS_PASSWORD=

# --- API ---
API_JWT_SECRET=
API_ALLOWED_ORIGINS=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_PUBLIC_BUCKET=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# --- IA para facturas (opcional) ---
ANTHROPIC_API_KEY=
IA_PRECIO_POR_PAGINA_GTQ=

# --- App Shiny (único valor que necesita; no es secreto) ---
API_BASE_URL=
